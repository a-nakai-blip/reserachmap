# researchmap API 設定
# researchmap (https://researchmap.jp) にログイン後、
# 「外部サービス連携」→「APIアクセストークン発行」でクライアントIDとシークレットを取得してください。

researchmap:
  client_id: "YOUR_CLIENT_ID"
  client_secret: "YOUR_CLIENT_SECRET"
  researcher_id: "YOUR_RESEARCHER_ID"   # researchmap の研究者ID (例: nakai_akira)

# 同期設定
sync:
  # dry_run: true にすると実際には書き込まず確認のみ
  dry_run: false
  # 既存データとのマッチングキー ("doi" または "title")
  match_key: "doi"
